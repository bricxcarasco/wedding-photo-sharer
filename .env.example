# ─────────────────────────────────────────────────────────────────────────────
# Bricx & Hannah Wedding — environment variables
#
# TWO AUDIENCES:
#  1. VITE_* vars are BUNDLED INTO THE BROWSER. They are PUBLIC. Never put a
#     secret here. Only safe, public values.
#  2. Everything else is SERVER-ONLY (Vercel Serverless Functions). These hold
#     the Google credentials and must NEVER be prefixed with VITE_.
#
# WHERE THEY GO:
#  - Local dev:  copy this file to `.env` and fill it in (git-ignored).
#  - Production: add each one in Vercel → Project → Settings → Environment
#                Variables (set for Production + Preview). Do NOT commit `.env`.
# ─────────────────────────────────────────────────────────────────────────────

# ── PUBLIC (safe for the browser) ───────────────────────────────────────────
# The canonical production URL. Used for share links / QR target / manifest.
VITE_APP_URL=https://your-wedding.vercel.app
# Couple + date are hard-coded in the UI, but exposed here if you want to tweak.
VITE_COUPLE=Bricx & Hannah
VITE_WEDDING_DATE=2027-02-06

# ── SERVER-ONLY SECRETS (never VITE_, never shipped to the browser) ──────────
# Google OAuth 2.0 "Desktop app" or "Web" client credentials.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Long-lived refresh token generated once with `npm run token` (see README).
GOOGLE_REFRESH_TOKEN=
# The Drive folder id of "Bricx & Hannah Wedding" (its subfolders are created
# automatically on first upload). Found in the folder URL after /folders/.
GOOGLE_DRIVE_FOLDER_ID=

# A shared secret used to generate the OAuth refresh token locally. Only needed
# by scripts/get-refresh-token.mjs; not used at runtime.
# OAUTH_REDIRECT=http://localhost:4567/oauth2callback

# ── OPTIONAL: rate limiting / gallery cache at scale (Vercel KV / Upstash) ───
# Leave blank to disable. The app runs fully without these.
KV_REST_API_URL=
KV_REST_API_TOKEN=
